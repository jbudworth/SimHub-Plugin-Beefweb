<UserControl x:Class="SimHub.Plugin.Beefweb.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             mc:Ignorable="d">
    <ScrollViewer>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title + Test connection / Save settings row, then full-width info text -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Beefweb Media Control" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Click="TestConnection_Click">Test connection</styles:SHButtonSecondary>
                    <styles:SHButtonPrimary Height="28" VerticalAlignment="Center" Margin="8,0,0,0" Click="Save_Click">Save settings</styles:SHButtonPrimary>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8">
                    Connects to a Foobar2000 instance running the Beefweb remote control component and exposes its
                    media info and playback controls to SimHub. Playback controls are available both as mappable
                    actions under Controls and as events of the same name.
                </TextBlock>
            </Grid>

            <!-- Connection settings, sized to its content -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Connection" ShowSeparator="True">
                    <StackPanel Margin="0,4,0,8">

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                            <TextBox x:Name="HostTextBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                            <TextBox x:Name="PortTextBox" Grid.Column="1" Width="100" HorizontalAlignment="Left" />
                        </Grid>

                        <styles:SHToggleCheckbox x:Name="UseAuthCheckbox" Margin="0,10,0,4"
                                                  Checked="UseAuthCheckbox_Changed" Unchecked="UseAuthCheckbox_Changed">
                            Use authentication
                        </styles:SHToggleCheckbox>

                        <Grid x:Name="AuthPanel" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" />
                            <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,4,0,0" />
                            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </Grid>

                        <ui:TitledSlider x:Name="PollingSlider" Title="Polling interval (ms)" Minimum="100" Maximum="2000" Margin="0,14,0,4" />
                        <ui:TitledSlider x:Name="SeekStepSlider" Title="Seek step (seconds)" Minimum="1" Maximum="60" Margin="0,8,0,4" />
                        <ui:TitledSlider x:Name="VolumeStepSlider" Title="Volume step (%)" Minimum="1" Maximum="25" Margin="0,8,0,4" />

                    </StackPanel>
                </styles:SHSection>
            </Border>

            <!-- Live status, sized to its content -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4">
                <styles:SHSection Title="Status" ShowSeparator="True">
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="" />
                    </StackPanel>
                </styles:SHSection>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
